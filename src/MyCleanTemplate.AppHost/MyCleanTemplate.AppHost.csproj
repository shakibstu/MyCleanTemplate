<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>de7da170-4515-464c-92f9-6021102bf002</UserSecretsId>
    <!-- DCP and the dashboard come from NuGet (AspireUseCliBundle=false), so the AppHost
         runs without the Aspire CLI installed. Set AspireUseCliBundle=true to use the CLI bundle instead. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyCleanTemplate.API\MyCleanTemplate.API.csproj" />
  </ItemGroup>

</Project>
